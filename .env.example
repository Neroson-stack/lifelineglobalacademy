# Database (PostgreSQL)
# For local: postgresql://user:password@localhost:5432/lifeline_academy
# For online (Supabase / Neon / Railway): paste the connection string
DATABASE_URL="postgresql://user:password@host:5432/lifeline_academy?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
NODE_ENV=development

# Optional: CORS origin (frontend URL)
CORS_ORIGIN="http://localhost:3000"
